<!DOCTYPE html>
<html>
<head>
<title>DesktopPet_Internal_PoC_Unique_7F31</title>
<hta:application id="desktopPetPoC" applicationname="DesktopPet Internal PoC"
  border="none" caption="no" contextmenu="no" maximizebutton="no"
  minimizebutton="no" scroll="no" selection="no" showintaskbar="no"
  singleinstance="yes" sysmenu="no" windowstate="normal" />
<meta http-equiv="X-UA-Compatible" content="IE=9" />
<style type="text/css">
html, body { margin:0; padding:0; overflow:hidden; font:12px Segoe UI,Arial,sans-serif; background:#ff00ff; }
#stage { position:relative; width:180px; height:170px; cursor:move;
  background:#ff00ff; }
#mascot { position:absolute; left:34px; top:24px; width:110px; height:105px; }
#petBody { position:absolute; left:10px; top:12px; width:90px; height:82px; border-radius:46px; background:#4397d3; border:3px solid #142a3a; }
.ear { position:absolute; top:0; width:0; height:0; border-left:18px solid transparent; border-right:18px solid transparent; border-bottom:34px solid #4397d3; }
#earLeft { left:4px; transform:rotate(-18deg); } #earRight { right:4px; transform:rotate(18deg); }
.eye { position:absolute; top:31px; width:13px; height:13px; border-radius:8px; background:#142a3a; }
#eyeLeft { left:25px; } #eyeRight { right:25px; }
#mouth { position:absolute; left:35px; top:57px; width:20px; height:9px; border-bottom:3px solid white; border-radius:0 0 18px 18px; }
#mascot.blink .eye { height:3px; top:36px; border-radius:0; }
#mascot.bob { top:20px; }
#alphaTest { position:absolute; right:4px; top:4px; width:32px; height:32px; border:1px solid #334; }
#tag { position:absolute; left:7px; bottom:5px; padding:3px 6px; background:#fff; border:1px solid #334; cursor:pointer; }
#diagnostics { position:absolute; left:180px; top:0; width:470px; height:350px; padding:8px; box-sizing:border-box; background:#fff; border:2px solid #375a7f; overflow:auto; }
h1 { font-size:15px; margin:0 0 5px; } p { margin:4px 0; } button { margin:2px; }
.status { font-weight:bold; } #errors { color:#8b0000; white-space:pre-wrap; }
table { width:100%; border-collapse:collapse; font-size:10px; } th,td { border:1px solid #aaa; padding:2px; text-align:left; }
</style>
<script language="JScript">
var running=true, timer=null, intervalMs=100, ticks=0, direction=1, frame=0;
var dragging=false, dragDX=0, dragDY=0, clicks=0, enumRequests=0;
var psInvocations=0, psExec=null, psPoll=null, psStarted=0, psTimeoutMs=20000;
var uniqueTitle="DesktopPet_Internal_PoC_Unique_7F31";
var transparentClassification="NOT_SUPPORTED";

function byId(id){ return document.getElementById(id); }
function text(id,value){ byId(id).innerText=value; }
function safeHtml(value){ return String(value).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/\"/g,"&quot;"); }
function logError(message){ byId("errors").innerText += (byId("errors").innerText?"\r\n":"")+message; }

function init(){
  window.resizeTo(670,390); window.moveTo(Math.max(0,screen.availWidth-690),Math.max(0,screen.availHeight-430));
  text("taskbar","requested hidden (showInTaskBar=no); verify manually");
  text("transparency","NOT_SUPPORTED");
  text("mouseCapture",typeof byId("mascot").setCapture!=="undefined"?"SUPPORTED":"NOT_SUPPORTED");
  window.onblur=endDrag;
  document.onkeydown=keyDown;
  testPersistence(); startLoop(); updateStats();
}
function startLoop(){ if(timer===null){ running=true; timer=window.setInterval(update,intervalMs); } updateStats(); }
function stopLoop(){ if(timer!==null){ window.clearInterval(timer); timer=null; } running=false; updateStats(); }
function update(){
  ticks++; frame=(frame+1)%2; byId("mascot").className=frame?"blink bob":"";
  if(!dragging && psExec===null){ var next=window.screenLeft+(direction*3); var max=Math.max(0,screen.availWidth-document.documentElement.clientWidth); if(next<=0){next=0;direction=1;} if(next>=max){next=max;direction=-1;} window.moveTo(next,window.screenTop); }
  updateStats();
}
function updateStats(){ text("running",running?"RUNNING":"STOPPED"); text("ticks",ticks); text("interval",intervalMs+" ms"); text("requests",enumRequests); text("threads","No persistent bridge. Animation uses one bounded timer; PowerShell runs only per explicit request."); text("clicks",clicks); text("dragState",dragging?"DRAGGING":"IDLE"); text("psCount",psInvocations); }
function toggleDiagnostics(){ var panel=byId("diagnostics"); if(panel.style.display==="none"){ panel.style.display="block"; window.resizeTo(670,390); }else{ panel.style.display="none"; window.resizeTo(180,200); } }
function mouseDown(){
  dragging=true; dragDX=event.screenX-window.screenLeft; dragDY=event.screenY-window.screenTop;
  var mascot=byId("mascot");
  if(typeof mascot.setCapture!=="undefined"){ try{ mascot.setCapture(); }catch(e){ text("mouseCapture","NOT_SUPPORTED"); } }
  updateStats(); event.cancelBubble=true;
}
function mouseMove(){ if(dragging){ if(event.button===0){ endDrag(); return; } window.moveTo(event.screenX-dragDX,event.screenY-dragDY); } }
function endDrag(){
  var mascot=byId("mascot"), wasDragging=dragging; dragging=false;
  if(wasDragging && typeof mascot.releaseCapture!=="undefined"){ try{ mascot.releaseCapture(); }catch(e){} }
  updateStats();
}
function keyDown(){ if(event.keyCode===27) endDrag(); }
function mascotClick(){ clicks++; text("lastAction","Mascot click detected"); updateStats(); }

function base64Utf16(value){
  var alphabet="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/", bytes=[], output="", i, n;
  for(i=0;i<value.length;i++){ n=value.charCodeAt(i); bytes.push(n&255,(n>>8)&255); }
  for(i=0;i<bytes.length;i+=3){ n=(bytes[i]<<16)|((i+1<bytes.length?bytes[i+1]:0)<<8)|(i+2<bytes.length?bytes[i+2]:0); output+=alphabet.charAt((n>>18)&63)+alphabet.charAt((n>>12)&63)+(i+1<bytes.length?alphabet.charAt((n>>6)&63):"=")+(i+2<bytes.length?alphabet.charAt(n&63):"="); }
  return output;
}
function psQuote(value){ return "'"+String(value).replace(/'/g,"''")+"'"; }
function readTextFile(path){ var fso=new ActiveXObject("Scripting.FileSystemObject"); if(!fso.FileExists(path))return ""; var f=fso.OpenTextFile(path,1,false,0), value=f.ReadAll(); f.Close(); return value; }
function runPowerShell(source,done){
  if(psExec!==null){ logError("PowerShell: a request is already running"); done("FAILED","","A request is already running"); return false; }
  psInvocations++; updateStats(); text("psExit","RUNNING");
  try{
    var shell=new ActiveXObject("WScript.Shell"), fso=new ActiveXObject("Scripting.FileSystemObject"), data=pocFolder()+"\\data";
    var resultPath=data+"\\bridge_result.txt", errorPath=data+"\\bridge_error.txt";
    if(fso.FileExists(resultPath))fso.DeleteFile(resultPath,true); if(fso.FileExists(errorPath))fso.DeleteFile(errorPath,true);
    text("bridgeResultFile",resultPath+" (waiting)"); text("bridgeError","none");
    source="$ProgressPreference='SilentlyContinue';$WarningPreference='SilentlyContinue';$InformationPreference='SilentlyContinue';$ErrorActionPreference='Stop';$resultPath="+psQuote(resultPath)+";$errorPath="+psQuote(errorPath)+";try{"+source+"}catch{[IO.File]::WriteAllText($errorPath,$_.Exception.ToString());exit 1}";
    var powershell=shell.ExpandEnvironmentStrings("%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe");
    psExec=shell.Exec("\""+powershell+"\" -NoLogo -NoProfile -NonInteractive -EncodedCommand "+base64Utf16(source));
  }catch(e){ psExec=null; text("psExit","NOT STARTED"); text("bridgeError",e.description); logError("PowerShell launch blocked: "+e.description); done("BLOCKED","",e.description); return false; }
  psStarted=(new Date()).getTime();
  psPoll=window.setInterval(function(){
    try{
      if(psExec.Status!==0){ var code=psExec.ExitCode, output=readTextFile(resultPath), error=readTextFile(errorPath); if(code!==0&&!error)error="PowerShell exited "+code+" without creating bridge_error.txt"; window.clearInterval(psPoll); psPoll=null; psExec=null; text("psExit",code===0?"YES (exit 0)":"NO (exit "+code+")"); text("bridgeResultFile",resultPath+(output?" (read)":" (missing/empty)")); text("bridgeError",error||"none"); if(error)logError("PowerShell bridge: "+error); done(code===0?"DONE":"FAILED",output,error); }
      else if((new Date()).getTime()-psStarted>psTimeoutMs){ psExec.Terminate(); window.clearInterval(psPoll); psPoll=null; psExec=null; text("psExit","NO (terminated after "+psTimeoutMs+" ms)"); text("bridgeError","Timed out and terminated"); logError("PowerShell request timed out and was terminated"); done("FAILED","","Timed out"); }
    }catch(e){ if(psPoll!==null)window.clearInterval(psPoll); psPoll=null; psExec=null; text("psExit","UNKNOWN"); text("bridgeError",e.description); logError("PowerShell monitoring: "+e.description); done("FAILED","",e.description); }
  },100);
  return true;
}
function nativeSource(body){
  return "Add-Type -TypeDefinition @'\r\nusing System;using System.Text;using System.Collections.Generic;using System.Diagnostics;using System.Runtime.InteropServices;public static class DPWin{public delegate bool EnumProc(IntPtr h,IntPtr p);[DllImport(\"user32.dll\")]static extern bool EnumWindows(EnumProc c,IntPtr p);[DllImport(\"user32.dll\")]static extern bool IsWindowVisible(IntPtr h);[DllImport(\"user32.dll\",CharSet=CharSet.Unicode)]static extern int GetWindowText(IntPtr h,StringBuilder s,int n);[DllImport(\"user32.dll\")]static extern bool GetWindowRect(IntPtr h,out RECT r);[DllImport(\"user32.dll\")]static extern uint GetWindowThreadProcessId(IntPtr h,out uint p);[DllImport(\"user32.dll\",SetLastError=true)]static extern int GetWindowLong(IntPtr h,int n);[DllImport(\"user32.dll\",SetLastError=true)]static extern int SetWindowLong(IntPtr h,int n,int v);[DllImport(\"user32.dll\",SetLastError=true)]static extern bool SetLayeredWindowAttributes(IntPtr h,uint key,byte alpha,uint flags);[DllImport(\"kernel32.dll\")]static extern void SetLastError(uint e);[StructLayout(LayoutKind.Sequential)]public struct RECT{public int Left,Top,Right,Bottom;}public static string Enumerate(){var b=new StringBuilder();EnumProc cb=delegate(IntPtr h,IntPtr p){RECT r;var t=new StringBuilder(512);if(IsWindowVisible(h)&&GetWindowText(h,t,t.Capacity)>0&&GetWindowRect(h,out r)){string title=t.ToString().Replace('\\t',' ').Replace('\\r',' ').Replace('\\n',' ');b.Append(h.ToInt64()).Append('\\t').Append(title).Append('\\t').Append(r.Left).Append('\\t').Append(r.Top).Append('\\t').Append(r.Right-r.Left).Append('\\t').Append(r.Bottom-r.Top).AppendLine();}return true;};EnumWindows(cb,IntPtr.Zero);return b.ToString();}public static string SetColorKey(int x,int y,int w,int hgt,bool enable){var matches=new List<IntPtr>();EnumProc cb=delegate(IntPtr hwnd,IntPtr p){uint pid;RECT r;GetWindowThreadProcessId(hwnd,out pid);try{if(Process.GetProcessById((int)pid).ProcessName.Equals(\"mshta\",StringComparison.OrdinalIgnoreCase)&&GetWindowRect(hwnd,out r)&&Math.Abs(r.Left-x)<=40&&Math.Abs(r.Top-y)<=40&&Math.Abs((r.Right-r.Left)-w)<=80&&Math.Abs((r.Bottom-r.Top)-hgt)<=80)matches.Add(hwnd);}catch{}return true;};EnumWindows(cb,IntPtr.Zero);if(matches.Count==0)return \"NOT_FOUND\\t0\\tNOT_SUPPORTED\";if(matches.Count!=1)return \"AMBIGUOUS\\t0\\tNOT_SUPPORTED\";IntPtr target=matches[0];SetLastError(0);int style=GetWindowLong(target,-20);int err=Marshal.GetLastWin32Error();if(style==0&&err!=0)throw new System.ComponentModel.Win32Exception(err);int next=enable?(style|0x80000):(style&~0x80000);SetLastError(0);int prior=SetWindowLong(target,-20,next);err=Marshal.GetLastWin32Error();if(prior==0&&err!=0)throw new System.ComponentModel.Win32Exception(err);if(enable&&!SetLayeredWindowAttributes(target,0x00FF00FF,255,1))throw new System.ComponentModel.Win32Exception(Marshal.GetLastWin32Error());return \"FOUND\\t\"+target.ToInt64()+\"\\t\"+(enable?\"COLORKEY_SUPPORTED\":\"OPAQUE_RESTORED\");}}\r\n'@;"+body;
}
function blockedError(value){ return /blocked|denied|unauthorized|policy|permission|not digitally signed/i.test(String(value)); }
function testPowerShellBridge(){
  text("psBridge","RUNNING"); byId("windowRows").innerHTML="";
  var body="[IO.File]::WriteAllText($resultPath,[DPWin]::Enumerate())";
  runPowerShell(nativeSource(body),function(state,output,error){
    if(state==="BLOCKED" || (state!=="DONE" && blockedError(error))){text("psBridge","BLOCKED");return;} if(state!=="DONE"){text("psBridge","FAILED");return;}
    var lines=output.replace(/\r/g,"").split("\n"), html="", valid=0;
    for(var i=0;i<lines.length && valid<20;i++){ var c=lines[i].split("\t"); if(c.length>=6 && !isNaN(Number(c[0]))){ html+="<tr><td>"+safeHtml(c[0])+"</td><td>"+safeHtml(c[1])+"</td><td>"+safeHtml(c[2])+"</td><td>"+safeHtml(c[3])+"</td><td>"+safeHtml(c[4])+"</td><td>"+safeHtml(c[5])+"</td><td>visible</td></tr>"; valid++; } }
    byId("windowRows").innerHTML=html; text("psBridge",valid>0?"PASS":"FAILED"); if(valid===0)logError("PowerShell bridge returned no valid window geometry. Output: "+output+" Error: "+error);
  });
}
function setTransparency(enable){
  text("transparentWindow","RUNNING");
  var x=window.screenLeft, y=window.screenTop, w=document.documentElement.clientWidth, h=document.documentElement.clientHeight;
  var body="$value=[DPWin]::SetColorKey("+x+","+y+","+w+","+h+","+(enable?"$true":"$false")+");[IO.File]::WriteAllText($resultPath,$value)";
  runPowerShell(nativeSource(body),function(state,output,error){ var c=output.replace(/\r|\n/g,"").split("\t"); if(c[0]==="FOUND")text("nativeWindow","FOUND hwnd="+c[1]);else if(c[0]==="AMBIGUOUS")text("nativeWindow","AMBIGUOUS");else text("nativeWindow","NOT_FOUND"); if(state==="BLOCKED" || (state!=="DONE" && blockedError(error))){transparentClassification="BLOCKED";text("transparentWindow","BLOCKED");}else if(state!=="DONE"){transparentClassification="FAILED";text("transparentWindow","FAILED");}else if(c[2]==="COLORKEY_SUPPORTED"){transparentClassification="COLORKEY_SUPPORTED";text("transparentWindow","COLORKEY_SUPPORTED (verify visually)");}else if(c[2]==="OPAQUE_RESTORED"){text("transparentWindow",transparentClassification+" (opaque restored)");}else if(c[0]==="NOT_FOUND" || c[0]==="AMBIGUOUS"){transparentClassification="FAILED";text("transparentWindow","FAILED");}else{transparentClassification="FAILED";text("transparentWindow","FAILED");logError("Transparency returned unexpected file content: "+output+" "+error);} });
}
function clearErrors(){ byId("errors").innerText=""; text("bridgeError","none"); }
function cleanupPowerShell(){ if(psPoll!==null){window.clearInterval(psPoll);psPoll=null;} if(psExec!==null){try{if(psExec.Status===0)psExec.Terminate();}catch(e){} psExec=null;} }
function exitPoC(){ cleanupPowerShell(); window.close(); }

function pocFolder(){ var p=decodeURI(location.pathname); if(p.charAt(0)==="/" && p.charAt(2)===":") p=p.substr(1); p=p.replace(/\//g,"\\"); return new ActiveXObject("Scripting.FileSystemObject").GetParentFolderName(p); }
function testPersistence(){
  try{
    var fso=new ActiveXObject("Scripting.FileSystemObject"), path=pocFolder()+"\\data\\settings.ini";
    var out=fso.CreateTextFile(path,true,false); out.WriteLine("speech=true"); out.WriteLine("testBond=57"); out.Close();
    var input=fso.OpenTextFile(path,1,false,0), contents=input.ReadAll(); input.Close();
    text("persistence",contents.indexOf("speech=true")>=0 && contents.indexOf("testBond=57")>=0?"PASS (write/read/reload)":"FAIL (content mismatch)");
  }catch(e){ text("persistence","FAIL"); logError("Persistence: "+e.description); }
}

function rectFrom(raw){
  var a=null; try{ if(raw && raw.toArray) a=raw.toArray(); }catch(ignore){}
  if(a && a.length>=4) return {left:Number(a[0]),top:Number(a[1]),width:Number(a[2])-Number(a[0]),height:Number(a[3])-Number(a[1])};
  try{ if(raw.left!==undefined) return {left:Number(raw.left),top:Number(raw.top),width:Number(raw.right)-Number(raw.left),height:Number(raw.bottom)-Number(raw.top)}; }catch(ignore2){}
  try{ if(raw.Left!==undefined) return {left:Number(raw.Left),top:Number(raw.Top),width:Number(raw.Right)-Number(raw.Left),height:Number(raw.Bottom)-Number(raw.Top)}; }catch(ignore3){}
  return null;
}
function testWindows(){
  enumRequests++; updateStats(); byId("windowRows").innerHTML=""; text("uia","probing"); text("windowResult","NOT_SUPPORTED");
  var automation=null, used="", ids=["UIAutomationClient.CUIAutomation","CUIAutomation"];
  for(var p=0;p<ids.length && automation===null;p++){ try{ automation=new ActiveXObject(ids[p]); used=ids[p]; }catch(e){ logError(ids[p]+": "+e.description); } }
  if(automation===null){ text("uia","unavailable/blocked"); return; }
  text("uia","available via "+used); var count=0, geometry=0, html="";
  try{
    var root=automation.GetRootElement(), condition=automation.CreateTrueCondition(), children=root.FindAll(2,condition);
    var length=Number(children.Length); if(isNaN(length)) length=0;
    for(var i=0;i<length && count<20;i++){
      try{
        var el=children.GetElement(i), name=""; try{name=el.CurrentName;}catch(ignoreName){}
        var rect=null; try{rect=rectFrom(el.CurrentBoundingRectangle);}catch(ignoreRect){}
        var enabled="?", offscreen="?"; try{enabled=el.CurrentIsEnabled?"yes":"no";}catch(ignoreEnabled){} try{offscreen=el.CurrentIsOffscreen?"yes":"no";}catch(ignoreOffscreen){}
        if(rect && isFinite(rect.left) && isFinite(rect.width)){ geometry++; html+="<tr><td>(UIA)</td><td>"+safeHtml(name||"(unnamed)")+"</td><td>"+Math.round(rect.left)+"</td><td>"+Math.round(rect.top)+"</td><td>"+Math.round(rect.width)+"</td><td>"+Math.round(rect.height)+"</td><td>enabled="+enabled+", offscreen="+offscreen+"</td></tr>"; }
        else { html+="<tr><td>(UIA)</td><td>"+safeHtml(name||"(unnamed)")+"</td><td colspan='4'>bounding rectangle unavailable to script</td><td>enabled="+enabled+", offscreen="+offscreen+"</td></tr>"; }
        count++;
      }catch(itemError){ logError("UIA child "+i+": "+itemError.description); }
    }
    byId("windowRows").innerHTML=html; text("windowResult",geometry>0?"WINDOW_GEOMETRY_SUPPORTED":(count>0?"WINDOW_ENUMERATION_ONLY":"NOT_SUPPORTED"));
  }catch(e){ logError("UI Automation enumeration: "+e.description); text("windowResult","NOT_SUPPORTED"); }
}
</script>
</head>
<body onload="init()" onunload="cleanupPowerShell()" onmousemove="mouseMove()" onmouseup="endDrag()" onblur="endDrag()" onkeydown="keyDown()">
<div id="stage">
  <div id="mascot" title="Original CSS test mascot" onmousedown="mouseDown()" onlosecapture="endDrag()" onclick="mascotClick()">
   <span class="ear" id="earLeft"></span><span class="ear" id="earRight"></span>
   <span id="petBody"><span class="eye" id="eyeLeft"></span><span class="eye" id="eyeRight"></span><span id="mouth"></span></span>
  </div>
  <!-- Original PoC-only transparent PNG, embedded to keep this change text-only. -->
  <img id="alphaTest" alt="Embedded transparent PNG alpha test" src="data:image/png;base64," />
  <span id="tag" onclick="toggleDiagnostics();event.cancelBubble=true">Diagnostics</span>
</div>
<div id="diagnostics" onmousedown="event.cancelBubble=true">
 <h1>DesktopPet Internal feasibility diagnostics</h1>
 <p>Transparency: <span class="status" id="transparency"></span> — transparent PNG pixels reveal the HTA stage/document background, not windows beneath it. HTA alone does not request a layered, per-pixel-composed native window.</p>
 <p>Taskbar: <span id="taskbar"></span></p>
 <p>Animation: <span id="running"></span>; interval <span id="interval"></span>; ticks <span id="ticks"></span>; clicks <span id="clicks"></span></p>
 <p>DRAG_STATE: <span class="status" id="dragState">IDLE</span>; MOUSE_CAPTURE: <span class="status" id="mouseCapture">NOT_SUPPORTED</span></p>
 <p>Background object/thread: <span id="threads"></span></p>
 <p>Persistence: <span class="status" id="persistence"></span></p>
 <p>UI Automation COM: <span id="uia">not tested</span>; requests: <span id="requests"></span></p>
 <p>Application terrain: <span class="status" id="windowResult">NOT_SUPPORTED (not tested yet)</span></p>
 <p>POWERSHELL_BRIDGE: <span class="status" id="psBridge">not tested</span>; invocations: <span id="psCount">0</span>; process exited cleanly: <span id="psExit">not run</span></p>
 <p>BRIDGE_RESULT_FILE: <span id="bridgeResultFile">not created</span></p>
 <p>BRIDGE_ERROR: <span id="bridgeError">none</span></p>
 <p>HTA_NATIVE_WINDOW: <span class="status" id="nativeWindow">not tested</span></p>
 <p>TRANSPARENT_WINDOW: <span class="status" id="transparentWindow">NOT_SUPPORTED (not tested yet)</span></p>
 <button onclick="startLoop()">Start</button><button onclick="stopLoop()">Stop</button>
 <button onclick="testPersistence()">Retest local file</button><button onclick="testWindows()">Test application windows</button>
 <button onclick="testPowerShellBridge()">Test PowerShell window bridge</button>
 <button onclick="setTransparency(true)">Test color-key transparency</button><button onclick="setTransparency(false)">Restore Opaque</button>
 <button onclick="clearErrors()">Clear diagnostic errors</button>
 <button onclick="toggleDiagnostics()">Hide diagnostics</button><button onclick="exitPoC()">Exit</button>
 <p>Last interaction: <span id="lastAction">none</span></p>
 <table><thead><tr><th>HWND</th><th>Name</th><th>Left</th><th>Top</th><th>Width</th><th>Height</th><th>Visible/Usable</th></tr></thead><tbody id="windowRows"></tbody></table>
 <div id="errors"></div>
</div>
</body>
</html>
